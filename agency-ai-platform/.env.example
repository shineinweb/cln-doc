# Agency AI Platform — local development only.
# Copy to .env and replace placeholder secrets before starting Docker or apps.
# Never commit .env. Never use production credentials here.

# Runtime
NODE_ENV=development

# ---------------------------------------------------------------------------
# Docker Compose — MariaDB
# ---------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agency_platform
MYSQL_USER=agency
MYSQL_PASSWORD=replace_with_local_mariadb_password
MYSQL_ROOT_PASSWORD=replace_with_local_mariadb_root_password

# Prisma / Nest (MariaDB via mysql protocol)
DATABASE_URL=mysql://agency:replace_with_local_mariadb_password@localhost:3306/agency_platform

# ---------------------------------------------------------------------------
# Docker Compose — Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
PORT=3000

# ---------------------------------------------------------------------------
# Public frontends (Vite — only VITE_* are exposed to the browser)
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api/v1
