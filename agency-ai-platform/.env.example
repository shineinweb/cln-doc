# Agency AI Platform — document every variable used by apps/packages here.
# Copy to .env for local development. Never commit real secrets.

# Runtime
NODE_ENV=development

# API (apps/api)
PORT=3000
DATABASE_URL=mysql://agency:agency@localhost:3306/agency_ai
REDIS_URL=redis://localhost:6379

# Public frontends (Vite — only VITE_* are exposed to the browser)
VITE_API_URL=http://localhost:3000/api/v1
