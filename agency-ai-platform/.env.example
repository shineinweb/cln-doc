# Agency AI Platform — local development only.
# Copy to .env and fill values before starting Docker or apps.
# Never commit .env. Never use production credentials here.

# Runtime
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Docker Compose — MariaDB
# Replace USER / PASSWORD in DATABASE_URL to match MYSQL_USER / MYSQL_PASSWORD.
# ---------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agency_platform
MYSQL_USER=agency
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/agency_platform"

# ---------------------------------------------------------------------------
# Docker Compose — Redis
# ---------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Secrets (server-side only — never expose to Vite / React)
# Leave empty until the related feature is configured locally.
# ---------------------------------------------------------------------------
JWT_SECRET=""
OPENAI_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Public frontends (Vite — only VITE_* are exposed to the browser)
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api/v1
