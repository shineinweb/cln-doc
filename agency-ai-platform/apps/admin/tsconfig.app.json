{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "moduleResolution": "Bundler",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@agency/ui": ["../../packages/ui/src"],
      "@agency/shared": ["../../packages/shared/src"],
      "@agency/ui/*": ["../../packages/ui/src/*"],
      "@agency/shared/*": ["../../packages/shared/src/*"],
      "@agency/auth/browser": ["../../packages/auth/src/browser.ts"]
    }
  },
  "include": ["src"]
}
