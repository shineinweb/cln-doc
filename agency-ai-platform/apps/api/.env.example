NODE_ENV=development
PORT=3000

# Prefer copying values from the repo-root .env (same MariaDB/Redis instance).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agency_platform
MYSQL_USER=agency
MYSQL_PASSWORD=replace_with_local_mariadb_password

DATABASE_URL=mysql://agency:replace_with_local_mariadb_password@localhost:3306/agency_platform
REDIS_URL=redis://localhost:6379
