// Agency AI Platform — MariaDB via Prisma (mysql provider only).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid()) @db.Char(36)
  email           String    @unique @db.VarChar(320)
  name            String    @db.VarChar(200)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at")
  isStaff         Boolean   @default(false) @map("is_staff")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  sessions            Session[]
  organizationMembers OrganizationMember[]
  auditLogs           AuditLog[]             @relation("AuditActor")
  customerContacts    CustomerContact[]
  authTokens          AuthToken[]
  userRoles           UserRole[]
  ownedLeads          Lead[]                 @relation("LeadOwner")
  ownedOpportunities  Opportunity[]          @relation("OpportunityOwner")
  ownedProjects       Project[]              @relation("ProjectOwner")
  leadActivities      LeadActivity[]         @relation("LeadActivityActor")

  @@index([isStaff, isActive])
  @@index([createdAt])
  @@map("users")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Char(36)
  userId    String        @map("user_id") @db.Char(36)
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  roleId    String   @map("role_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  tokenHash String   @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id        String    @id @default(uuid()) @db.Char(36)
  name      String    @db.VarChar(200)
  slug      String    @unique @db.VarChar(120)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  members       OrganizationMember[]
  customer      Customer?
  auditLogs     AuditLog[]
  leads         Lead[]
  opportunities Opportunity[]
  quotes        Quote[]
  projects      Project[]
  invoices      Invoice[]
  subscriptions Subscription[]

  @@index([createdAt])
  @@map("organizations")
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

model OrganizationMember {
  id             String                 @id @default(uuid()) @db.Char(36)
  organizationId String                 @map("organization_id") @db.Char(36)
  userId         String                 @map("user_id") @db.Char(36)
  role           OrganizationMemberRole @default(MEMBER)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("organization_members")
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid()) @db.Char(36)
  key         String   @unique @db.VarChar(100)
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Char(36)
  key         String   @unique @db.VarChar(150)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Char(36)
  roleId       String   @map("role_id") @db.Char(36)
  permissionId String   @map("permission_id") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Customer profile (organization-scoped)
// ---------------------------------------------------------------------------

model Customer {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @unique @map("organization_id") @db.Char(36)
  displayName    String    @map("display_name") @db.VarChar(200)
  legalName      String?   @map("legal_name") @db.VarChar(200)
  status         String    @default("active") @db.VarChar(40)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     CustomerContact[]
  projects     Project[]
  invoices     Invoice[]
  subscriptions Subscription[]

  @@index([status, createdAt])
  @@map("customers")
}

model CustomerContact {
  id         String   @id @default(uuid()) @db.Char(36)
  customerId String   @map("customer_id") @db.Char(36)
  userId     String?  @map("user_id") @db.Char(36)
  name       String   @db.VarChar(200)
  email      String   @db.VarChar(320)
  phone      String?  @db.VarChar(40)
  title      String?  @db.VarChar(120)
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([customerId, isPrimary])
  @@index([email])
  @@index([userId])
  @@map("customer_contacts")
}

// ---------------------------------------------------------------------------
// Audit (append-only)
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid()) @db.Char(36)
  actorUserId    String?  @map("actor_user_id") @db.Char(36)
  actorType      String   @map("actor_type") @db.VarChar(40)
  organizationId String?  @map("organization_id") @db.Char(36)
  action         String   @db.VarChar(120)
  entityType     String   @map("entity_type") @db.VarChar(80)
  entityId       String   @map("entity_id") @db.VarChar(64)
  beforeJson     Json?    @map("before_json")
  afterJson      Json?    @map("after_json")
  ip             String?  @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(512)
  createdAt      DateTime @default(now()) @map("created_at")

  actorUser    User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Commercial lifecycle
// Lead → Opportunity → Quote → Customer → Project → Invoice → Recurring Services
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

model Lead {
  id               String     @id @default(uuid()) @db.Char(36)
  organizationId   String?    @map("organization_id") @db.Char(36)
  ownerUserId      String?    @map("owner_user_id") @db.Char(36)
  status           LeadStatus @default(NEW)
  source           String?    @db.VarChar(80)
  companyName      String?    @map("company_name") @db.VarChar(200)
  contactName      String     @map("contact_name") @db.VarChar(200)
  email            String     @db.VarChar(320)
  phone            String?    @db.VarChar(40)
  title            String?    @db.VarChar(200)
  notes            String?    @db.Text
  convertedAt      DateTime?  @map("converted_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")

  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  owner         User?         @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  activities    LeadActivity[]
  opportunities Opportunity[]

  @@index([status, createdAt])
  @@index([email])
  @@index([organizationId, createdAt])
  @@index([ownerUserId])
  @@map("leads")
}

enum LeadActivityType {
  NOTE
  CALL
  EMAIL
  STATUS_CHANGE
  MEETING
}

model LeadActivity {
  id          String           @id @default(uuid()) @db.Char(36)
  leadId      String           @map("lead_id") @db.Char(36)
  actorUserId String?          @map("actor_user_id") @db.Char(36)
  type        LeadActivityType @default(NOTE)
  body        String           @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation("LeadActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([actorUserId])
  @@map("lead_activities")
}

enum OpportunityStage {
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Opportunity {
  id             String           @id @default(uuid()) @db.Char(36)
  leadId         String?          @map("lead_id") @db.Char(36)
  organizationId String?          @map("organization_id") @db.Char(36)
  ownerUserId    String?          @map("owner_user_id") @db.Char(36)
  name           String           @db.VarChar(200)
  stage          OpportunityStage @default(QUALIFICATION)
  amountCents    Int?             @map("amount_cents")
  currency       String           @default("USD") @db.Char(3)
  expectedClose  DateTime?        @map("expected_close")
  wonAt          DateTime?        @map("won_at")
  lostAt         DateTime?        @map("lost_at")
  lossReason     String?          @map("loss_reason") @db.VarChar(500)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")

  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  owner        User?         @relation("OpportunityOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  quotes       Quote[]

  @@index([stage, createdAt])
  @@index([leadId])
  @@index([organizationId, createdAt])
  @@index([ownerUserId])
  @@map("opportunities")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id             String      @id @default(uuid()) @db.Char(36)
  opportunityId  String?     @map("opportunity_id") @db.Char(36)
  organizationId String?     @map("organization_id") @db.Char(36)
  number         String      @unique @db.VarChar(40)
  title          String      @db.VarChar(200)
  status         QuoteStatus @default(DRAFT)
  currency       String      @default("USD") @db.Char(3)
  subtotalCents  Int         @default(0) @map("subtotal_cents")
  taxCents       Int         @default(0) @map("tax_cents")
  totalCents     Int         @default(0) @map("total_cents")
  validUntil     DateTime?   @map("valid_until")
  sentAt         DateTime?   @map("sent_at")
  acceptedAt     DateTime?   @map("accepted_at")
  rejectedAt     DateTime?   @map("rejected_at")
  notes          String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")

  opportunity  Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  lineItems    QuoteLineItem[]
  projects     Project[]
  invoices     Invoice[]
  subscriptions Subscription[]

  @@index([status, createdAt])
  @@index([opportunityId])
  @@index([organizationId, createdAt])
  @@map("quotes")
}

model QuoteLineItem {
  id          String   @id @default(uuid()) @db.Char(36)
  quoteId     String   @map("quote_id") @db.Char(36)
  sortOrder   Int      @default(0) @map("sort_order")
  description String   @db.VarChar(500)
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitCents   Int      @map("unit_cents")
  totalCents  Int      @map("total_cents")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, sortOrder])
  @@map("quote_line_items")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id             String        @id @default(uuid()) @db.Char(36)
  organizationId String        @map("organization_id") @db.Char(36)
  customerId     String?       @map("customer_id") @db.Char(36)
  quoteId        String?       @map("quote_id") @db.Char(36)
  ownerUserId    String?       @map("owner_user_id") @db.Char(36)
  name           String        @db.VarChar(200)
  status         ProjectStatus @default(PLANNING)
  startsAt       DateTime?     @map("starts_at")
  dueAt          DateTime?     @map("due_at")
  completedAt    DateTime?     @map("completed_at")
  summary        String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quote        Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  owner        User?        @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  invoices     Invoice[]
  subscriptions Subscription[]

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@index([customerId])
  @@index([quoteId])
  @@index([ownerUserId])
  @@map("projects")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
  OVERDUE
}

model Invoice {
  id             String        @id @default(uuid()) @db.Char(36)
  organizationId String        @map("organization_id") @db.Char(36)
  customerId     String?       @map("customer_id") @db.Char(36)
  projectId      String?       @map("project_id") @db.Char(36)
  quoteId        String?       @map("quote_id") @db.Char(36)
  number         String        @unique @db.VarChar(40)
  status         InvoiceStatus @default(DRAFT)
  currency       String        @default("USD") @db.Char(3)
  subtotalCents  Int           @default(0) @map("subtotal_cents")
  taxCents       Int           @default(0) @map("tax_cents")
  totalCents     Int           @default(0) @map("total_cents")
  amountPaidCents Int          @default(0) @map("amount_paid_cents")
  issuedAt       DateTime?     @map("issued_at")
  dueAt          DateTime?     @map("due_at")
  paidAt         DateTime?     @map("paid_at")
  notes          String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quote        Quote?           @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  lineItems    InvoiceLineItem[]

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@index([customerId])
  @@index([projectId])
  @@index([quoteId])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String   @id @default(uuid()) @db.Char(36)
  invoiceId   String   @map("invoice_id") @db.Char(36)
  sortOrder   Int      @default(0) @map("sort_order")
  description String   @db.VarChar(500)
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitCents   Int      @map("unit_cents")
  totalCents  Int      @map("total_cents")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
  @@map("invoice_line_items")
}

/// Recurring Services stage — hosting, retainers, maintenance subscriptions.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
}

model Subscription {
  id               String               @id @default(uuid()) @db.Char(36)
  organizationId   String               @map("organization_id") @db.Char(36)
  customerId       String?              @map("customer_id") @db.Char(36)
  projectId        String?              @map("project_id") @db.Char(36)
  quoteId          String?              @map("quote_id") @db.Char(36)
  name             String               @db.VarChar(200)
  status           SubscriptionStatus   @default(TRIALING)
  interval         SubscriptionInterval @default(MONTHLY)
  amountCents      Int                  @map("amount_cents")
  currency         String               @default("USD") @db.Char(3)
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  cancelAt         DateTime?            @map("cancel_at")
  canceledAt       DateTime?            @map("canceled_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  deletedAt        DateTime?            @map("deleted_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  project      Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quote        Quote?             @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  items        SubscriptionItem[]

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@index([customerId])
  @@index([projectId])
  @@index([quoteId])
  @@map("subscriptions")
}

model SubscriptionItem {
  id             String   @id @default(uuid()) @db.Char(36)
  subscriptionId String   @map("subscription_id") @db.Char(36)
  sortOrder      Int      @default(0) @map("sort_order")
  description    String   @db.VarChar(500)
  quantity       Decimal  @default(1) @db.Decimal(12, 2)
  unitCents      Int      @map("unit_cents")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, sortOrder])
  @@map("subscription_items")
}
