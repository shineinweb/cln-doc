generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// A cultivation company. Users, sites, and licenses all belong to one organization.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users    User[]
  sites    Site[]
  licenses License[]
  roles    Role[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  email          String   @unique
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credential   Credential?
  memberships  SiteMembership[]
  userRoles    UserRole[]

  @@index([organizationId])
  @@map("users")
}

/// Password storage is separate from the user profile so later login methods can be added.
model Credential {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

/// Global permission catalog. Roles grant these inside an organization.
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String   @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  key            String
  name           String
  description    String   @db.VarChar(500)
  /// Org-wide roles can open every site in the organization. Other roles need a site membership.
  isOrgWide      Boolean  @default(false) @map("is_org_wide")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  userRoles    UserRole[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// A physical facility. This is not a regulated license.
model Site {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  code           String
  addressLine1   String?  @map("address_line1")
  city           String?
  region         String?
  postalCode     String?  @map("postal_code")
  timezone       String   @default("America/Los_Angeles")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rooms        Room[]
  memberships  SiteMembership[]
  licenses     LicenseSite[]
  metrcSyncs   MetrcSync[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("sites")
}

/// Explicit grant to open one site. Organization admins do not need a row here.
model SiteMembership {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  siteId    String   @map("site_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([siteId])
  @@map("site_memberships")
}

/// Regulated license. Inventory will later be scoped here. Phase 1 stores the record only.
model License {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  licenseNumber  String    @map("license_number")
  licenseType    String    @map("license_type")
  jurisdiction   String
  status         String    @default("active")
  issuedOn       DateTime? @map("issued_on") @db.Date
  expiresOn      DateTime? @map("expires_on") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sites        LicenseSite[]

  @@unique([organizationId, licenseNumber])
  @@index([organizationId])
  @@map("licenses")
}

/// A license may cover activity at one or more physical sites. The site is still not the license.
model LicenseSite {
  licenseId String   @map("license_id")
  siteId    String   @map("site_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([licenseId, siteId])
  @@map("license_sites")
}

model Room {
  id        String   @id @default(cuid())
  siteId    String   @map("site_id")
  name      String
  code      String
  roomType  String   @map("room_type")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site     Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zones    Zone[]
  cycles   CropCycle[]
  tasks    RoomTask[]
  alerts   RoomAlert[]
  readings EnvironmentalReading[]

  @@unique([siteId, code])
  @@index([siteId])
  @@map("rooms")
}

model Zone {
  id        String   @id @default(cuid())
  roomId    String   @map("room_id")
  name      String
  code      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, code])
  @@index([roomId])
  @@map("zones")
}

/// A crop occupying a room. Cycle day is not stored; it is derived from startDate and the site timezone.
model CropCycle {
  id                  String   @id @default(cuid())
  roomId              String   @map("room_id")
  name                String
  cultivar            String
  plantCount          Int      @map("plant_count")
  stage               String
  startDate           DateTime @map("start_date") @db.Date
  expectedHarvestDate DateTime @map("expected_harvest_date") @db.Date
  status              String
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  room            Room                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  events          CycleEvent[]
  movements       CycleMovement[]
  observations    CycleObservation[]
  laborEntries    CycleLaborEntry[]
  harvestSummary  HarvestResultSummary?

  @@index([roomId, status])
  @@map("crop_cycles")
}

model CycleEvent {
  id         String   @id @default(cuid())
  cycleId    String   @map("cycle_id")
  occurredOn DateTime @map("occurred_on") @db.Date
  title      String
  detail     String?  @db.VarChar(2000)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  cycle CropCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId])
  @@map("cycle_events")
}

model CycleMovement {
  id         String   @id @default(cuid())
  cycleId    String   @map("cycle_id")
  occurredOn DateTime @map("occurred_on") @db.Date
  fromLabel  String   @map("from_label")
  toLabel    String   @map("to_label")
  plantCount Int      @map("plant_count")
  note       String?  @db.VarChar(2000)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  cycle CropCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId])
  @@map("cycle_movements")
}

model CycleObservation {
  id         String   @id @default(cuid())
  cycleId    String   @map("cycle_id")
  occurredOn DateTime @map("occurred_on") @db.Date
  authorName String   @map("author_name")
  body       String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  cycle CropCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId])
  @@map("cycle_observations")
}

model CycleLaborEntry {
  id         String   @id @default(cuid())
  cycleId    String   @map("cycle_id")
  occurredOn DateTime @map("occurred_on") @db.Date
  personName String   @map("person_name")
  hours      Decimal  @db.Decimal(5, 2)
  note       String?  @db.VarChar(2000)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  cycle CropCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId])
  @@map("cycle_labor_entries")
}

/// A written result for the cycle page. This is not the harvest workflow.
model HarvestResultSummary {
  id         String   @id @default(cuid())
  cycleId    String   @unique @map("cycle_id")
  recordedOn DateTime @map("recorded_on") @db.Date
  summary    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  cycle CropCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@map("harvest_result_summaries")
}

/// Later phases will generate these. Phase 2 only reads rows that already exist.
model RoomTask {
  id        String   @id @default(cuid())
  roomId    String   @map("room_id")
  title     String
  dueOn     DateTime @map("due_on") @db.Date
  status    String   @default("open")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, dueOn])
  @@map("room_tasks")
}

model RoomAlert {
  id        String   @id @default(cuid())
  roomId    String   @map("room_id")
  message   String   @db.VarChar(500)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, active])
  @@map("room_alerts")
}

model EnvironmentalReading {
  id         String   @id @default(cuid())
  roomId     String   @map("room_id")
  recordedAt DateTime @map("recorded_at")
  metric     String
  value      Decimal  @db.Decimal(10, 2)
  unit       String
  isSample   Boolean  @default(false) @map("is_sample")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, recordedAt])
  @@map("environmental_readings")
}

/// A recorded sync outcome. Phase 2 does not call Metrc.
model MetrcSync {
  id          String    @id @default(cuid())
  siteId      String    @map("site_id")
  status      String
  succeededAt DateTime? @map("succeeded_at")
  isSample    Boolean   @default(false) @map("is_sample")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, succeededAt])
  @@map("metrc_syncs")
}
