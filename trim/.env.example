NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Dev database. Tests use trim_test and do not read this value.
DATABASE_URL=mysql://trim:trim@127.0.0.1:3306/trim

# Dev-only signing secret. Change it before any shared deployment.
JWT_SECRET=dev-only-change-me-trim-jwt-secret
JWT_EXPIRES_IN_SECONDS=43200

REDIS_URL=redis://127.0.0.1:6379

# S3-compatible attachment storage. Phase 1 configures the client only.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=trim-attachments
S3_ACCESS_KEY=trim
S3_SECRET_KEY=trimsecret
S3_FORCE_PATH_STYLE=true

# Server-side only. The inventory import does not send these anywhere.
METRC_INTEGRATOR_KEY=
METRC_USER_KEY=

# Optional. Helps Serenity answer with OpenAI. Organization Settings → API's can store a per-company key instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
