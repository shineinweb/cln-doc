NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://instagram:instagram@127.0.0.1:3306/instagram_ai
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=replace-with-a-long-random-string
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/integrations/instagram/callback
META_VERIFY_TOKEN=replace-meta-verify-token
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_DEV_ASSIGN=true
TEXT_PROVIDER_KEY=
MEDIA_PROVIDER_KEY=
VIDEO_PROVIDER_URL=
MEDIA_PUBLIC_BASE_URL=http://localhost:4000
STORAGE_DIR=./data/media
