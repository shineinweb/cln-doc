{
  "name": "@instagram-ai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/index.ts",
    "start": "node --env-file=../../.env --import tsx src/index.ts",
    "worker": "node --env-file=../../.env --import tsx src/worker.ts",
    "test": "prisma generate && vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "db:push": "node --env-file=../../.env ./node_modules/prisma/build/index.js db push",
    "db:seed": "node --env-file=../../.env --import tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@instagram-ai/shared": "workspace:*",
    "@prisma/client": "^5.22.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "bullmq": "^5.34.5",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
